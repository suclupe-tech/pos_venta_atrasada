<odoo>

    <record id="action_report_nota_venta_pos" model="ir.actions.report">
        <field name="name">Nota de Venta POS</field>
        <field name="model">pos.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_venta_atrasada.report_nota_venta_pos_template</field>
        <field name="report_file">pos_venta_atrasada.report_nota_venta_pos_template</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_nota_venta_pos_template">

        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <div class="page"
                    style="font-family: 'Courier New';
                            font-size: 12px;
                            width: 80mm;
                            margin: 0 auto;
                            color: #000;
                            font-weight: bold;">

                    <!-- HEADER -->
                    <div style="text-align:center; margin-bottom:8px;">

                        <t t-if="o.company_id.logo">
                            <img t-att-src="'/web/image/res.company/%s/logo' % o.company_id.id"
                            style="max-width:160px; max-height:70px; margin-bottom:6px;"/>
                        </t>

                        <div style="font-size:16px; font-weight:bold;">
                            <t t-esc="o.company_id.name"/>
                        </div>

                        <div>
                            RUC: <t t-esc="o.company_id.vat"/>
                        </div>

                        <div style="font-size:12px; font-weight:bold;">
                            <t t-esc="o.config_id.name"/>
                        </div>

                        <div style="margin-top:5px;
                                    font-size:15px;
                                    font-weight:bold;
                                    border-top:1px dashed #000;
                                    border-bottom:1px dashed #000;
                                    padding:4px 0;">
                            NOTA DE VENTA
                        </div>

                        <div style="font-size:14px; font-weight:bold; margin-top:5px;">
                            <t t-esc="o.sunat_document_number or o.name"/>
                        </div>

                    </div>

                    <!-- DATOS -->
                    <table style="width:100%; margin-bottom:8px; font-size:11px;">

                        <tr>
                            <td><strong>Fecha:</strong></td>
                            <td style="text-align:right;">
                                <t t-esc="context_timestamp(o.date_order).strftime('%d/%m/%Y')"/>
                            </td>
                        </tr>

                        <tr>
                            <td><strong>Hora:</strong></td>
                            <td style="text-align:right;">
                                <t t-esc="context_timestamp(o.date_order).strftime('%H:%M')"/>
                            </td>
                        </tr>

                        <tr>
                            <td><strong>Fecha real:</strong></td>
                            <td style="text-align:right;">
                                <t t-esc="o.fecha_real_venta or ''"/>
                            </td>
                        </tr>

                        <tr>
                            <td><strong>Cliente:</strong></td>
                            <td style="text-align:right;">
                                <t t-esc="o.partner_id.name or 'PUBLICO GENERAL'"/>
                            </td>
                        </tr>

                        <tr>
                            <td><strong>DNI/RUC:</strong></td>
                            <td style="text-align:right;">
                                <t t-esc="o.partner_id.vat or '00000000'"/>
                            </td>
                        </tr>

                        <tr>
                            <td><strong>Tienda:</strong></td>
                            <td style="text-align:right;">
                                <t t-esc="o.config_id.name"/>
                            </td>
                        </tr>

                    </table>

                    <!-- PRODUCTOS -->
                    <div style="border-top:1px dashed #000;
                                border-bottom:1px dashed #000;
                                padding:4px 0;
                                margin-bottom:5px;">

                        <table style="width:100%;
                                    font-size:11px;
                                    border-collapse:collapse;">

                            <thead>
                                <tr>
                                    <th style="text-align:left; width:45%;">Producto</th>
                                    <th style="text-align:center; width:15%;">Cant</th>
                                    <th style="text-align:right; width:20%;">P.Unit</th>
                                    <th style="text-align:right; width:20%;">Total</th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr t-foreach="o.lines" t-as="line">

                                    <td style="padding:3px 0;">
                                        <t t-esc="line.product_id.display_name"/>
                                    </td>

                                    <td style="text-align:center;">
                                        <t t-esc="line.qty"/>
                                    </td>

                                    <td style="text-align:right;">
                                        <t t-esc="'%.2f' % line.price_unit"/>
                                    </td>

                                    <td style="text-align:right; font-weight:bold;">
                                        <t t-esc="'%.2f' % line.price_subtotal_incl"/>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                    <!-- TOTAL -->
                    <div style="margin-top:8px;">

                        <table style="width:100%; font-size:13px;">

                            <tr>
                                <td style="text-align:left;">
                                    <strong>TOTAL</strong>
                                </td>

                                <td style="text-align:right; font-weight:bold;">
                                    S/ <t t-esc="'%.2f' % o.amount_total"/>
                                </td>
                            </tr>

                        </table>

                    </div>

                    <!-- FOOTER -->
                    <div style="margin-top:15px;
                                text-align:center;
                                font-size:10px;
                                border-top:1px dashed #000;
                                padding-top:6px;">

                        Gracias por su compra<br/>
                        Documento interno<br/>
                        No válido para crédito fiscal

                    </div>

                </div>

            </t>
        </t>

    </template>

</odoo>